# Copy to backend/.env (or export in the Passenger/systemd environment).
# All keys use the FOUNDRY_ prefix.

FOUNDRY_SECRET_KEY=change-me-in-production
FOUNDRY_LISTEN_HOST=127.0.0.1
FOUNDRY_LISTEN_PORT=8411

# Admin bootstrap password for scott@perrinresearch.com.
# If unset, a random password is generated on first run and printed to logs.
# FOUNDRY_ADMIN_PASSWORD=

# Local checkouts root used when building agent-prompt claim payloads.
# Workers (WSL Cursor) use repo_cwd / repo_slug to open the right repo.
# On the VPS this is usually the WSL path as a hint for remote workers:
FOUNDRY_REPOS_ROOT=/home/scott/perrinresearch/repos

# FOUNDRY_EVAL_API_URL=https://foundry.perrinresearch.com/eval
# FOUNDRY_EVAL_EMAIL=
# FOUNDRY_EVAL_PASSWORD=
# FOUNDRY_GITHUB_TOKEN=
# FOUNDRY_GITHUB_ORG=perrinresearch
# FOUNDRY_GITHUB_WEBHOOK_SECRET=
